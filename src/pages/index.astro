---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

import { Background } from '@/components/background';
import { FAQ } from '@/components/blocks/faq';
import { Features } from '@/components/blocks/features';
import { Hero } from '@/components/blocks/hero';
import { Logos } from '@/components/blocks/logos';

import { Services } from '@/components/blocks/services';
import { BlogPreview } from '@/components/blocks/blog-preview';
import { Testimonials } from '@/components/blocks/testimonials';
import { TechStack } from '@/components/blocks/tech-stack';
import { WorkPreview } from '@/components/blocks/work-preview';
import DefaultLayout from '@/layouts/DefaultLayout.astro';



---

<DefaultLayout title={SITE_TITLE} description={SITE_DESCRIPTION} >
  <Background className="via-muted to-muted/80">
    <Hero />
    <Logos client:only="react"/> 
    <Features />
    <Services />
  </Background>
  <TechStack client:only="react"/>
  <WorkPreview />
  <Testimonials client:only='react'/>
  <BlogPreview />
  <Background variant="bottom">
    <FAQ client:only='react'/>
  </Background>
</DefaultLayout>