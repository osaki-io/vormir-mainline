---
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

import { Background } from '@/components/background';
import { WebflowHero } from '@/components/blocks/webflow-hero';
import { WebflowServices } from '@/components/blocks/webflow-services';
import { WhyWebflow } from '@/components/blocks/why-webflow';
import { HowWeWork } from '@/components/blocks/how-we-work';
import { LetsTalk } from '@/components/blocks/lets-talk';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
---

<DefaultLayout title={`Webflow Development — ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <Background className="via-muted to-muted/80">
    <WebflowHero />
    <WebflowServices />
  </Background>
  <WhyWebflow />
  <Background variant="bottom">
    <HowWeWork />
    <LetsTalk />
  </Background>
</DefaultLayout>